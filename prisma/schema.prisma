generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Authorization & Authentication
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // null for Google OAuth
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  boards   Board[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// Main buisness logic
model Board {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String   @default("#3b82f6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups Group[]

  @@map("boards")
}

model Group {
  id        String   @id @default(uuid())
  name      String
  order     Int      @default(0)
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@map("groups")
}

model Task {
  id          String   @id @default(uuid())
  name        String
  description String?
  priority    Int      @default(5)
  isDone      Boolean  @default(false)
  dueDate     DateTime
  order       Int      @default(0)
  groupId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("tasks")
}